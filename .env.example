# Public frontend configuration; never put credentials here.
REACT_APP_API_BASE_URL=https://www.pieback.com
# Root URL containing Build/ and StreamingAssets/. Set the real CDN URL in Vercel.
REACT_APP_UNITY_BASE_URL=
REACT_APP_UNITY_BUILD_NAME=WebBuild
# Change for each uploaded Unity build. Prefer a versioned CDN folder as well.
REACT_APP_UNITY_BUILD_VERSION=20260915-1
